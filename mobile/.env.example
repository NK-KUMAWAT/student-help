# Base URL of the Express API server.
# Dev on a physical device: use your machine's LAN IP, e.g. http://192.168.1.10:3001
# Dev on Android emulator: http://10.0.2.2:3001
# Dev on iOS simulator: http://localhost:3001
# Production: your deployed API origin, e.g. https://api.example.com
# If left unset in dev, the app auto-derives the host from the Expo dev server.
EXPO_PUBLIC_API_URL=
