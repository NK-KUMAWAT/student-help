# Server
PORT=3001
NODE_ENV=development
# Set USE_IN_MEMORY_MONGO=false to use a real MongoDB (set MONGODB_URI below).
USE_IN_MEMORY_MONGO=true
MONGODB_URI=mongodb://127.0.0.1:27017/ai_placement_compass
JWT_SECRET=dev-secret-change-me
CLIENT_ORIGIN=http://localhost:5173

# LLM (OpenAI-compatible). Required for resume skill extraction + support chat.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o

# Optional: publicly reachable base URL so the LLM can fetch uploaded resumes.
# In local dev the LLM cannot reach localhost; set this to a tunnel URL if you
# need resume parsing to work end-to-end.
PUBLIC_BASE_URL=

# Frontend (Vite). Only set if the API is on a different origin than the
# frontend in production. In dev, Vite proxies /api to the Express server.
# VITE_API_URL=
